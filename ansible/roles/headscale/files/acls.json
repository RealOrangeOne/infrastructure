{
    "tagOwners": {
        "tag:client": [],
        "tag:private-svcs": []

    },
    "acls": [
        {
            "action": "accept",
            "src": ["tag:client"],
            "dst": ["*:*"]
        },
        {
          "action": "accept",
          "src": ["*"],
          "dst": ["{{ tailscale_nodes.tang.ip }}:53"]
        },
        {
            "action": "accept",
            "src": ["tag:private-svcs"],
            "dst": ["{{ tailscale_nodes.ingress.ip }}:80,443", "{{ pve_hosts.ingress.external_ip }}:80,443", "{{ pve_hosts.ingress.external_ipv6 }}:80,443"]
        }
    ]
}
